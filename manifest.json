{
  "manifest_version": 3,
  "name": "CAIS - rodinhas laterais de bike",
  "version": "2.3.1",
  "description": "Validação em tempo real e onboarding para o fluxo de check-in do OC.",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CAIS - rodinhas laterais de bike"
  },
  "permissions": [],
  "host_permissions": [
    "https://accorcu2.oraclehospitality.us-ashburn-1.ocs.oraclecloud.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://accorcu2.oraclehospitality.us-ashburn-1.ocs.oraclecloud.com/*"
      ],
      "js": [
        "rules/sidebar.js",
        "rules/businessCard.js",
        "rules/rateBreakfast.js",
        "rules/email.js",
        "rules/address.js",
        "rules/travelAgent.js",
        "rules/totalCost.js",
        "rules/checkinLock.js",
        "rules/allMembership.js",
        "rules/balanceCheck.js",
        "rules/cardDataGuard.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "Nunito_Sans/*"
      ],
      "matches": [
        "https://accorcu2.oraclehospitality.us-ashburn-1.ocs.oraclecloud.com/*"
      ]
    }
  ]
}
